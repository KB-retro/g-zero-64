+void GfxRenderingAPIOGL::Gz64SnapshotScene(int fbId) {
+    if (fbId <= 0 || fbId >= (int)mFrameBuffers.size()) {
+        return;
+    }
+    const FramebufferOGL& fb = mFrameBuffers[fbId];
+    if (mGz64SceneTex == 0 || mGz64SceneW != fb.width || mGz64SceneH != fb.height) {
+        if (mGz64SceneTex == 0) {
+            glGenTextures(1, &mGz64SceneTex);
+            glGenFramebuffers(1, &mGz64SceneFbo);
+        }
+        GLint prevTexture = 0;
+        glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTexture);
+        glBindTexture(GL_TEXTURE_2D, mGz64SceneTex);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, fb.width, fb.height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindTexture(GL_TEXTURE_2D, (GLuint)prevTexture);
+        glBindFramebuffer(GL_FRAMEBUFFER, mGz64SceneFbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, mGz64SceneTex, 0);
+        mGz64SceneW = fb.width;
+        mGz64SceneH = fb.height;
+    }
+    if (mLastScissorEnabled != 0) {
+        glDisable(GL_SCISSOR_TEST);
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, fb.fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, mGz64SceneFbo);
+    glBlitFramebuffer(0, 0, (GLint)fb.width, (GLint)fb.height, 0, 0, (GLint)fb.width, (GLint)fb.height,
+                      GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, mFrameBuffers[mCurrentFrameBuffer].fbo);
+    if (mLastScissorEnabled != 0) {
+        glEnable(GL_SCISSOR_TEST);
+    }
+    gGz64SceneValid = true;
+}
