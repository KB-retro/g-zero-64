+static const char* sGz64BloomDownFs = GZ64_FS_PRELUDE
+    "uniform sampler2D uTex;\n"
+    "uniform vec2 uInSize;\n"
+    "uniform float uThreshold;\n"
+    "vec3 F(ivec2 p) { return texelFetch(uTex, clamp(p, ivec2(0), ivec2(uInSize) - 1), 0).rgb; }\n"
