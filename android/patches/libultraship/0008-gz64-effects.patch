+    "    vec3 sum = vec3(0.0);\n"
+    "    for (int y = 0; y < 4; y++) {\n"
+    "        for (int x = 0; x < 4; x++) {\n"
+    "            vec3 c = F(base + ivec2(x, y));\n"
+    "            float b = max(c.r, max(c.g, c.b));\n"
+    "            float k = clamp((b - uThreshold) / (1.0 - uThreshold + 1.0e-4), 0.0, 1.0);\n"
+    "            sum += c * k * k;\n"
+    "        }\n"
+    "    }\n"
+    "    gdxFragColor = vec4(sum / 16.0, 1.0);\n"
+    "}\n";
+
+static const char* sGz64BlurFs = GZ64_FS_PRELUDE
+    "uniform sampler2D uTex;\n"
+    "uniform vec2 uInSize;\n"
+    "uniform vec2 uDir;\n"
