+    "    sum += (F(p + ivec2(uDir * 4.0)) + F(p - ivec2(uDir * 4.0))) * 0.1216;\n"
+    "    sum += (F(p + ivec2(uDir * 6.0)) + F(p - ivec2(uDir * 6.0))) * 0.0540;\n"
