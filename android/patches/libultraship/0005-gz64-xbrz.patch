+// G-Zero 64: xBRZ upscaling of the game's own decoded textures (port/gz64_xbrz.cpp). The factor
+// (0 = off, 2-4) is latched in StartFrame, which empties the texture cache when it changes so every
+// texture is decoded again at the new size.
+extern "C" const uint8_t* gz64_xbrz_scale(const uint8_t* rgba32, uint32_t width, uint32_t height, int factor,
+                                          uint32_t* outWidth, uint32_t* outHeight);
+static int sGz64XbrzFactor = 0;
+
+static void Gz64UploadDecoded(GfxRenderingAPI* rapi, const uint8_t* rgba32, uint32_t width, uint32_t height) {
+    uint32_t scaledWidth = width;
+    uint32_t scaledHeight = height;
+    const uint8_t* scaled = sGz64XbrzFactor >= 2
+                                ? gz64_xbrz_scale(rgba32, width, height, sGz64XbrzFactor, &scaledWidth, &scaledHeight)
+                                : nullptr;
+    if (scaled != nullptr) {
+        rapi->UploadTexture(scaled, scaledWidth, scaledHeight);
+    } else {
+        rapi->UploadTexture(rgba32, width, height);
+    }
+}
