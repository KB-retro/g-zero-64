<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp"
    android:background="@drawable/launcher_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/quick_title" android:textColor="#F3F6F7"
        android:textSize="20sp" android:textStyle="bold|italic" android:fontFamily="sans-serif-condensed" />
    <TextView android:id="@+id/quick_version"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#8E92AA" android:textSize="12sp" />
    <Button android:id="@+id/quick_options"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:minHeight="48dp"
        android:background="@drawable/launcher_button" android:backgroundTint="@null" android:textColor="#2A1606"
        android:text="@string/quick_options" android:textAllCaps="false"
        android:textSize="15sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="20dp" android:orientation="horizontal">
        <Button android:id="@+id/quick_resume"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:minHeight="52dp"
            android:background="@drawable/quick_green" android:backgroundTint="@null"
            android:text="@string/quick_resume" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@+id/quick_exit"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:minHeight="52dp"
            android:background="@drawable/quick_red" android:backgroundTint="@null"
            android:text="@string/quick_exit" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
